{
  "name": "orvexa",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun --env-file=.env run --cwd apps/web dev --host 127.0.0.1",
    "build": "bun run --cwd apps/web build",
    "check": "bun run --cwd apps/web check && tsc --noEmit -p tsconfig.worker.json",
    "db:migrate": "bun --env-file=.env scripts/migrate.ts",
    "worker": "bun --env-file=.env apps/worker/src/index.ts",
    "test": "bun test tests/unit.test.ts",
    "test:integration": "bun --env-file=.env test tests/integration.test.ts"
  },
  "dependencies": {
    "@langchain/core": "latest",
    "@langchain/langgraph": "latest",
    "@langchain/langgraph-checkpoint-postgres": "latest",
    "better-auth": "latest",
    "bullmq": "latest",
    "drizzle-orm": "latest",
    "ioredis": "^6.0.0",
    "pg": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/bun": "latest",
    "@types/pg": "latest",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "~6.0.0"
  }
}
