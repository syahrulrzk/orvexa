# ============================================================
# ORVEXA — Environment Example
# Copy ke .env lalu isi nilainya. JANGAN commit file .env.
# ============================================================

# --- Timezone (WAJIB) ---
TZ=Asia/Jakarta
PGTZ=Asia/Jakarta

# --- Database (local dev: localhost; docker compose: host "postgres") ---
DATABASE_URL=postgres://orvexa:orvexa@localhost:5432/orvexa

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Secrets (WAJIB di-generate) ---
# Master key untuk enkripsi kredensial (AES-256-GCM). 32 byte base64.
# Generate: openssl rand -base64 32
ORVEXA_MASTER_KEY=

# Secret sesi Auth.js. Minimal 32 byte.
# Generate: openssl rand -base64 32
AUTH_SECRET=

# Token antar service Next.js <-> Python worker.
# Generate: openssl rand -hex 32
INTERNAL_API_TOKEN=

# Secret HMAC webhook masuk (X-Orvexa-Signature: t=<unix>,v1=<hex>).
# Generate: openssl rand -hex 32
ORVEXA_WEBHOOK_SECRET=

# --- Akses / Domain ---
# Dev di server (akses langsung): http://<IP-SERVER>:3000
# Prod via reverse proxy Caddy:     https://originlabs.my.id
AUTH_URL=http://localhost:3000

# Domain untuk Caddy (dipakai saat `--profile proxy`)
ORVEXA_DOMAIN=originlabs.my.id

# --- Auth OAuth (opsional) ---
# Auth.js v5 membaca var ini otomatis; provider aktif bila keduanya diisi.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Upload / attachment ---
# Folder penyimpanan lokal (dipasang sebagai volume di docker compose)
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=26214400

# --- Object storage (opsional, roadmap) ---
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=orvexa

# --- Worker ---
WORKER_CONCURRENCY=4

# OQ-09 — retry berjenjang + dead-letter
# Job gagal tetap di PEL, direclaim setelah idle ini, retry s.d. MAX_DELIVERIES,
# lalu dipindah ke stream dead-letter (default agent.jobs.dead).
# WORKER_MAX_DELIVERIES=3
# WORKER_RECLAIM_IDLE_MS=60000
# WORKER_DEAD_STREAM=agent.jobs.dead

# ============================================================
# AI Provider (Fase 3)
# ============================================================
# Agent bisa memakai kredensial dari DB (menu Providers, terenkripsi
# AES-256-GCM dengan ORVEXA_MASTER_KEY) ATAU fallback ke env di bawah ini.
# Isi minimal satu supaya agent bisa benar-benar membalas di room.

# OpenAI (chat + embedding)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# Provider OpenAI-compatible (Together, Groq, vLLM, OpenRouter, dsb.)
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=http://host.docker.internal:8000/v1

# LLM lokal (Ollama / llama.cpp / LM Studio)
# LOCAL_LLM_API_KEY=ollama
# LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1

# Budget default per run (bisa dioverride per agent)
AGENT_MAX_STEPS=8
AGENT_MAX_TOKENS=12000
AGENT_TIMEOUT_SECONDS=180

# ============================================================
# MCP servers (Fase 6)
# ============================================================

# Demo MCP server (echo/now) untuk uji konektivitas — set URL lalu db:seed
# MCP_DEMO_URL=http://localhost:8091/mcp

# Server MCP Prometheus (F6-02): seed mendaftarkan tools + grant NOC
# bila URL diset. Jalankan: docker compose --profile mcp up -d mcp-prometheus
# MCP_PROMETHEUS_URL=http://localhost:9101/mcp
# PROMETHEUS_URL=http://localhost:9090
# MCP_PROM_BEARER=        # (opsional) bearer inline server MCP ini

# Server MCP Grafana (F6-02): seed mendaftarkan tools + grant NOC bila URL diset
# MCP_GRAFANA_URL=http://localhost:9102/mcp
# GRAFANA_URL=http://localhost:3001
# GRAFANA_API_KEY=        # service account token (glsa_...) / basic user:pass
# MCP_GRAFANA_BEARER=     # (opsional) bearer inline server MCP ini

# Server MCP Wazuh (F6-03): JWT auth (basic → token di-cache server MCP)
# MCP_WAZUH_URL=http://localhost:9103/mcp
# WAZUH_URL=https://localhost:55000
# WAZUH_USER=wazuh-wui
# WAZUH_PASS=             # password API Wazuh
# WAZUH_TLS_VERIFY=false  # true bila sertifikat valid
# MCP_WAZUH_BEARER=       # (opsional) bearer inline server MCP ini

# Server MCP Docker (F6-03): Docker Engine API via unix socket (read-only)
# MCP_DOCKER_URL=http://localhost:9104/mcp
# MCP_DOCKER_BEARER=      # (opsional) bearer inline server MCP ini

# Server MCP Kubernetes (F6-03): via kubectl (read-only)
# MCP_KUBERNETES_URL=http://localhost:9105/mcp
# KUBECONFIG_PATH=~/.kube/config  # path kubeconfig di host (mount read-only)
# MCP_K8S_BEARER=         # (opsional) bearer inline server MCP ini

# Server MCP UniFi (F6-04): cookie SESSION (login form / UniFi OS)
# MCP_UNIFI_URL=http://localhost:9106/mcp
# UNIFI_URL=https://localhost:8443
# UNIFI_USER=
# UNIFI_PASS=
# UNIFI_TLS_VERIFY=false
# MCP_UNIFI_BEARER=       # (opsional) bearer inline server MCP ini

# Server MCP MikroTik (F6-04): RouterOS REST API (Basic auth, RouterOS >= 7.1)
# MCP_MIKROTIK_URL=http://localhost:9107/mcp
# MIKROTIK_URL=https://192.168.88.1
# MIKROTIK_USER=admin
# MIKROTIK_PASS=
# MIKROTIK_TLS_VERIFY=false
# MCP_MIKROTIK_BEARER=    # (opsional) bearer inline server MCP ini

# Server MCP FortiGate (F6-04): REST API v2 (token) — "Firewall" di PRD
# MCP_FORTIGATE_URL=http://localhost:9108/mcp
# FORTIGATE_URL=https://192.168.1.99
# FORTIGATE_TOKEN=        # REST API token (bukan password admin)
# FORTIGATE_TLS_VERIFY=false
# MCP_FORTIGATE_BEARER=   # (opsional) bearer inline server MCP ini
