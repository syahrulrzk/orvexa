# ============================================================
# ORVEXA — Environment Example
# Copy ke .env lalu isi nilainya. JANGAN commit file .env.
# ============================================================

# --- Timezone (WAJIB) ---
TZ=Asia/Jakarta
PGTZ=Asia/Jakarta

# --- Database (local dev: localhost; docker compose: host "postgres") ---
DATABASE_URL=postgres://orvexa:orvexa@localhost:5432/orvexa

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Secrets (WAJIB di-generate) ---
# Master key untuk enkripsi kredensial (AES-256-GCM). 32 byte base64.
# Generate: openssl rand -base64 32
ORVEXA_MASTER_KEY=

# Secret sesi Auth.js. Minimal 32 byte.
# Generate: openssl rand -base64 32
AUTH_SECRET=

# Token antar service Next.js <-> Python worker.
# Generate: openssl rand -hex 32
INTERNAL_API_TOKEN=

# Secret HMAC webhook masuk (X-Orvexa-Signature: t=<unix>,v1=<hex>).
# Generate: openssl rand -hex 32
ORVEXA_WEBHOOK_SECRET=

# --- Akses / Domain ---
# Dev di server (akses langsung): http://<IP-SERVER>:3000
# Prod via reverse proxy Caddy:     https://originlabs.my.id
AUTH_URL=http://localhost:3000

# Domain untuk Caddy (dipakai saat `--profile proxy`)
ORVEXA_DOMAIN=originlabs.my.id

# --- Auth OAuth (opsional) ---
# Auth.js v5 membaca var ini otomatis; provider aktif bila keduanya diisi.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Upload / attachment ---
# Folder penyimpanan lokal (dipasang sebagai volume di docker compose)
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=26214400

# --- Object storage (opsional, roadmap) ---
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=orvexa

# --- Worker ---
WORKER_CONCURRENCY=4

# ============================================================
# AI Provider (Fase 3)
# ============================================================
# Agent bisa memakai kredensial dari DB (menu Providers, terenkripsi
# AES-256-GCM dengan ORVEXA_MASTER_KEY) ATAU fallback ke env di bawah ini.
# Isi minimal satu supaya agent bisa benar-benar membalas di room.

# OpenAI (chat + embedding)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# Provider OpenAI-compatible (Together, Groq, vLLM, OpenRouter, dsb.)
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=http://host.docker.internal:8000/v1

# LLM lokal (Ollama / llama.cpp / LM Studio)
# LOCAL_LLM_API_KEY=ollama
# LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1

# Budget default per run (bisa dioverride per agent)
AGENT_MAX_STEPS=8
AGENT_MAX_TOKENS=12000
AGENT_TIMEOUT_SECONDS=180
